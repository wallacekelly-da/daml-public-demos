module Main where

type AssetId = ContractId Asset

data Category = Cash | Stock
  deriving (Eq, Show)

template Asset
  with
    issuer : Party
    owner  : Party
    name   : Text
    category : Category
  where
    ensure name /= ""
    signatory issuer
    observer owner
    choice Give : AssetId
      with
        newOwner : Party
      controller owner
      do create this with
           owner = newOwner
